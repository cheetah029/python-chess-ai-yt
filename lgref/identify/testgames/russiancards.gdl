% ============================================================
% Russian Cards -- GDL-III test game, infix HRF.
% After van Ditmarsch, "The Russian Cards Problem", Studia
% Logica 75 (2003).
%
% Seven cards, 0..6. Alice is dealt three, Bob three, Cath one;
% each sees only her or his own hand. Then two public
% announcements, each chosen from a small fixed menu:
%   Alice: sum(S)       the sum of my cards is S modulo 7
%          hand(X,Y,Z)  my hand is X, Y, Z
%          pass         nothing
%   Bob:   cath(C)      Cath holds C -- only if Bob KNOWS it
%          pass
% Every announcement is truthful, because it is legal only when
% true (Bob's only when known: after Alice passes, Bob holding
% three cards still has four candidates for Cath's).
%
% Alice and Bob win when, afterwards, both know the whole deal
% and Cath knows, of no card she does not hold, who holds it.
% The known safe protocol is sum(S) then cath(C). Alice naming
% her own hand tells Cath everything.
% ============================================================
role(alice)
role(bob)
role(cath)
role(random)
init(round(0))
player(alice)
player(bob)
player(cath)
card(0)
card(1)
card(2)
card(3)
card(4)
card(5)
card(6)
lt(0,1)
lt(0,2)
lt(0,3)
lt(0,4)
lt(0,5)
lt(0,6)
lt(1,2)
lt(1,3)
lt(1,4)
lt(1,5)
lt(1,6)
lt(2,3)
lt(2,4)
lt(2,5)
lt(2,6)
lt(3,4)
lt(3,5)
lt(3,6)
lt(4,5)
lt(4,6)
lt(5,6)
addmod(0,0,0)
addmod(0,1,1)
addmod(0,2,2)
addmod(0,3,3)
addmod(0,4,4)
addmod(0,5,5)
addmod(0,6,6)
addmod(1,0,1)
addmod(1,1,2)
addmod(1,2,3)
addmod(1,3,4)
addmod(1,4,5)
addmod(1,5,6)
addmod(1,6,0)
addmod(2,0,2)
addmod(2,1,3)
addmod(2,2,4)
addmod(2,3,5)
addmod(2,4,6)
addmod(2,5,0)
addmod(2,6,1)
addmod(3,0,3)
addmod(3,1,4)
addmod(3,2,5)
addmod(3,3,6)
addmod(3,4,0)
addmod(3,5,1)
addmod(3,6,2)
addmod(4,0,4)
addmod(4,1,5)
addmod(4,2,6)
addmod(4,3,0)
addmod(4,4,1)
addmod(4,5,2)
addmod(4,6,3)
addmod(5,0,5)
addmod(5,1,6)
addmod(5,2,0)
addmod(5,3,1)
addmod(5,4,2)
addmod(5,5,3)
addmod(5,6,4)
addmod(6,0,6)
addmod(6,1,0)
addmod(6,2,1)
addmod(6,3,2)
addmod(6,4,3)
addmod(6,5,4)
addmod(6,6,5)
% Hands are dealt in increasing order, so each of the 140 deals
% is one move.
legal(random,deal(A1,A2,A3,B1,B2,B3,C)) :- true(round(0)) & lt(A1,A2) & lt(A2,A3) & lt(B1,B2) & lt(B2,B3) & distinct(B1,A1) & distinct(B1,A2) & distinct(B1,A3) & distinct(B2,A1) & distinct(B2,A2) & distinct(B2,A3) & distinct(B3,A1) & distinct(B3,A2) & distinct(B3,A3) & card(C) & distinct(C,A1) & distinct(C,A2) & distinct(C,A3) & distinct(C,B1) & distinct(C,B2) & distinct(C,B3)
legal(random,noop) :- ~true(round(0))
legal(P,noop) :- player(P) & true(round(0))
next(hand(A1,A2,A3)) :- does(random,deal(A1,A2,A3,B1,B2,B3,C))
next(hand(A1,A2,A3)) :- true(hand(A1,A2,A3))
next(holds(alice,X)) :- does(random,deal(X,A2,A3,B1,B2,B3,C))
next(holds(alice,X)) :- does(random,deal(A1,X,A3,B1,B2,B3,C))
next(holds(alice,X)) :- does(random,deal(A1,A2,X,B1,B2,B3,C))
next(holds(bob,X)) :- does(random,deal(A1,A2,A3,X,B2,B3,C))
next(holds(bob,X)) :- does(random,deal(A1,A2,A3,B1,X,B3,C))
next(holds(bob,X)) :- does(random,deal(A1,A2,A3,B1,B2,X,C))
next(holds(cath,X)) :- does(random,deal(A1,A2,A3,B1,B2,B3,X))
next(holds(P,X)) :- true(holds(P,X))
sees(alice,mine(X)) :- does(random,deal(X,A2,A3,B1,B2,B3,C))
sees(alice,mine(X)) :- does(random,deal(A1,X,A3,B1,B2,B3,C))
sees(alice,mine(X)) :- does(random,deal(A1,A2,X,B1,B2,B3,C))
sees(bob,mine(X)) :- does(random,deal(A1,A2,A3,X,B2,B3,C))
sees(bob,mine(X)) :- does(random,deal(A1,A2,A3,B1,X,B3,C))
sees(bob,mine(X)) :- does(random,deal(A1,A2,A3,B1,B2,X,C))
sees(cath,mine(X)) :- does(random,deal(A1,A2,A3,B1,B2,B3,X))
owns(P,X) :- true(holds(P,X))
aliceSum(S) :- true(hand(A1,A2,A3)) & addmod(A1,A2,T) & addmod(T,A3,S)
% Round 1: Alice announces.
legal(alice,announce(sum(S))) :- true(round(1)) & aliceSum(S)
legal(alice,announce(hand(A1,A2,A3))) :- true(round(1)) & true(hand(A1,A2,A3))
legal(alice,announce(pass)) :- true(round(1))
legal(bob,noop) :- true(round(1))
legal(cath,noop) :- true(round(1))
% Round 2: Bob announces. C is unbound under knows: the instance
% true in the actual position is the only candidate.
legal(bob,announce(cath(C))) :- true(round(2)) & knows(bob,owns(cath,C))
legal(bob,announce(pass)) :- true(round(2))
legal(alice,noop) :- true(round(2))
legal(cath,noop) :- true(round(2))
sees(P,said(S,M)) :- player(P) & does(S,announce(M))
next(round(1)) :- true(round(0))
next(round(2)) :- true(round(1))
next(round(3)) :- true(round(2))
terminal :- true(round(3))
% Knowing who holds card X. P is unbound under knows.
knowsOwner(R,X) :- player(R) & card(X) & knows(R,owns(P,X))
missesSome(R) :- player(R) & card(X) & ~knowsOwner(R,X)
knowsDeal(R) :- player(R) & ~missesSome(R)
cathLearns :- card(X) & ~true(holds(cath,X)) & knowsOwner(cath,X)
safe :- knowsDeal(alice) & knowsDeal(bob) & ~cathLearns
goal(alice,100) :- safe
goal(alice,0) :- ~safe
goal(bob,100) :- safe
goal(bob,0) :- ~safe
goal(cath,100) :- ~safe
goal(cath,0) :- safe
goal(random,0)
