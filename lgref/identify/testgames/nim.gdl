% ============================================================
% Single-pile nim -- LGREF validation game, infix HRF (the
% project's OFFICIAL dialect, issue #190). Deliberately unlike
% Royal Chess: no cells, no spatial structure at all.
% ============================================================
role(first)
role(second)
legal(P,take(1)) :- true(control(P)) & true(pile(N)) & positive(N)
legal(P,take(2)) :- true(control(P)) & true(pile(N)) & atleast2(N)
legal(first,noop) :- true(control(second))
legal(second,noop) :- true(control(first))
next(pile(M)) :- does(P,take(1)) & true(pile(N)) & succ(M,N)
next(pile(M)) :- does(P,take(2)) & true(pile(N)) & succ(K,N) & succ(M,K)
succ(0,1)
succ(1,2)
succ(2,3)
succ(3,4)
succ(4,5)
positive(N) :- succ(M,N)
atleast2(N) :- succ(K,N) & positive(K)
next(control(first)) :- true(control(second))
next(control(second)) :- true(control(first))
empty_pile :- true(pile(0))
terminal :- empty_pile
goal(P,100) :- empty_pile & true(control(P))
init(pile(5))
init(control(first))
