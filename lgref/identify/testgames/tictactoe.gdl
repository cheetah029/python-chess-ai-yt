; Tic-tac-toe. A validation game for rule identification: small enough
; that a human can state its rule boundaries with certainty, and
; structurally unlike Royal Chess (no pieces, no movement, no captures)
; so it tests that identification is not chess-shaped.
;
; Ground truth in ground_truth.py.

(role xplayer)
(role oplayer)

; ---- marking a cell ----
(<= (legal ?p (mark ?m ?n)) (true (control ?p)) (true (cell ?m ?n b)))
(<= (legal xplayer noop) (true (control oplayer)))
(<= (legal oplayer noop) (true (control xplayer)))
(<= (next (cell ?m ?n x)) (does xplayer (mark ?m ?n)))
(<= (next (cell ?m ?n o)) (does oplayer (mark ?m ?n)))
(<= (next (cell ?m ?n ?w)) (true (cell ?m ?n ?w)) (distinct ?w b))
(<= (next (cell ?m ?n b)) (true (cell ?m ?n b)) (does ?p (mark ?j ?k)) (or (distinct ?m ?j) (distinct ?n ?k)))

; ---- turn alternation ----
(<= (next (control xplayer)) (true (control oplayer)))
(<= (next (control oplayer)) (true (control xplayer)))

; ---- line detection ----
(<= (row ?m ?w) (true (cell ?m 1 ?w)) (true (cell ?m 2 ?w)) (true (cell ?m 3 ?w)))
(<= (column ?n ?w) (true (cell 1 ?n ?w)) (true (cell 2 ?n ?w)) (true (cell 3 ?n ?w)))
(<= (diagonal ?w) (true (cell 1 1 ?w)) (true (cell 2 2 ?w)) (true (cell 3 3 ?w)))
(<= (diagonal ?w) (true (cell 1 3 ?w)) (true (cell 2 2 ?w)) (true (cell 3 1 ?w)))
(<= (line ?w) (row ?m ?w))
(<= (line ?w) (column ?n ?w))
(<= (line ?w) (diagonal ?w))

; ---- board-full detection ----
(<= (open) (true (cell ?m ?n b)))

; ---- terminal and goal ----
(<= terminal (line x))
(<= terminal (line o))
(<= terminal (not (open)))
(<= (goal xplayer 100) (line x))
(<= (goal oplayer 100) (line o))

(init (cell 1 1 b)) (init (cell 1 2 b)) (init (cell 1 3 b))
(init (cell 2 1 b)) (init (cell 2 2 b)) (init (cell 2 3 b))
(init (cell 3 1 b)) (init (cell 3 2 b)) (init (cell 3 3 b))
(init (control xplayer))
