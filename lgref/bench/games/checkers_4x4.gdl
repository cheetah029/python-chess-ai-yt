% ============================================================
% Checkers 4x4 -- Paper A fresh test game, infix HRF (the project's
% OFFICIAL dialect, issue #190). Written for #370, AFTER the
% freeze (ab7b33b).
%
% A 4x4 board; pieces stand on the squares (X,Y) with X+Y odd.
% White starts with men on (2,1) and (4,1) and moves up the board;
% black starts with men on (1,4) and (3,4) and moves down. White
% moves first.
%   - A man steps one square diagonally forward onto an empty
%     square. A king steps one square diagonally in any direction.
%   - A piece JUMPS by passing diagonally over an adjacent enemy
%     piece, in a direction it may step, onto the empty square
%     just beyond; the enemy piece is captured. One jump per turn.
%   - Capture is forced: a player who can jump may not step.
%   - A man that ends its move on the far row (row 4 for white,
%     row 1 for black) becomes a king.
%   - A player with no legal move on their turn loses. After 16
%     turns in all, the game ends drawn.
%
% WHAT IT ADDS. Forced capture: whether any capture is available
% restricts which ordinary moves are legal.
% ============================================================

role(white)
role(black)

% ---- coordinates and directions
index(1)
index(2)
index(3)
index(4)
forward(white,1,2)
forward(white,2,3)
forward(white,3,4)
forward(black,4,3)
forward(black,3,2)
forward(black,2,1)
near(1,2)
near(2,1)
near(2,3)
near(3,2)
near(3,4)
near(4,3)
straddle(1,2,3)
straddle(2,3,4)
straddle(3,2,1)
straddle(4,3,2)
opponent(white,black)
opponent(black,white)

% ---- occupancy
occupied(X,Y) :- true(at(P,K,X,Y))
empty(X,Y) :- index(X) & index(Y) & ~occupied(X,Y)
enemy(P,X,Y) :- true(at(Q,K,X,Y)) & opponent(P,Q)

% ---- which way each kind of piece goes
heading(P,man,Y,Y2) :- forward(P,Y,Y2)
heading(P,king,Y,Y2) :- role(P) & near(Y,Y2)

% ---- stepping
step(P,X,Y,X2,Y2) :- true(at(P,K,X,Y)) & heading(P,K,Y,Y2) & near(X,X2) & empty(X2,Y2)
legal(P,step(X,Y,X2,Y2)) :- true(control(P)) & step(P,X,Y,X2,Y2) & ~canjump(P)

% ---- jumping, and forced capture
jump(P,X,Y,X2,Y2) :- true(at(P,K,X,Y)) & heading(P,K,Y,Y1) & straddle(Y,Y1,Y2) & straddle(X,X1,X2) & enemy(P,X1,Y1) & empty(X2,Y2)
canjump(P) :- jump(P,X,Y,X2,Y2)
legal(P,jump(X,Y,X2,Y2)) :- true(control(P)) & jump(P,X,Y,X2,Y2)
jumped(X1,Y1) :- does(P,jump(X,Y,X2,Y2)) & straddle(X,X1,X2) & straddle(Y,Y1,Y2)

% ---- the board update, with promotion on the far row
arrives(P,K,X2,Y2) :- does(P,step(X,Y,X2,Y2)) & true(at(P,K,X,Y))
arrives(P,K,X2,Y2) :- does(P,jump(X,Y,X2,Y2)) & true(at(P,K,X,Y))
left(X,Y) :- does(P,step(X,Y,X2,Y2))
left(X,Y) :- does(P,jump(X,Y,X2,Y2))
next(at(P,K,X,Y)) :- arrives(P,K,X,Y) & ~farrow(P,Y)
next(at(Q,K,X,Y)) :- true(at(Q,K,X,Y)) & ~left(X,Y) & ~jumped(X,Y)
farrow(white,4)
farrow(black,1)
next(at(P,king,X,Y)) :- arrives(P,K,X,Y) & farrow(P,Y)

% ---- alternation and the turn count
legal(white,noop) :- true(control(black))
legal(black,noop) :- true(control(white))
next(control(white)) :- true(control(black))
next(control(black)) :- true(control(white))
succ(0,1)
succ(1,2)
succ(2,3)
succ(3,4)
succ(4,5)
succ(5,6)
succ(6,7)
succ(7,8)
succ(8,9)
succ(9,10)
succ(10,11)
succ(11,12)
succ(12,13)
succ(13,14)
succ(14,15)
succ(15,16)
next(tick(N2)) :- true(tick(N)) & succ(N,N2)

% ---- ending: no legal move loses; the turn limit draws
mobile(P) :- step(P,X,Y,X2,Y2)
mobile(P) :- jump(P,X,Y,X2,Y2)
stuck(P) :- true(control(P)) & ~mobile(P)
blocked :- stuck(P)
timeup :- true(tick(16)) & ~blocked
terminal :- blocked
terminal :- timeup
goal(P,0) :- stuck(P)
goal(P,100) :- opponent(P,Q) & stuck(Q)
goal(P,50) :- role(P) & timeup

init(at(white,man,2,1))
init(at(white,man,4,1))
init(at(black,man,1,4))
init(at(black,man,3,4))
init(control(white))
init(tick(0))
